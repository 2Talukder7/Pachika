# ====================================================================
# PACHIKA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env and replace placeholders with your actual keys.
# Pachika works 100% offline out-of-the-box with its built-in engine.
# External keys are completely optional.
# ====================================================================

# Port for local Flask server (default: 5000)
PORT=5000
FLASK_DEBUG=False

# Optional: Google Gemini API Key for dynamic recipe generation of exotic dishes
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Alternative Providers
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google Cloud Text-to-Speech API key
# (If blank, Pachika automatically uses built-in gTTS or client-side Web Speech API)
# GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
