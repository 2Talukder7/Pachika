# ====================================================================
# PACHIKA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env and replace placeholders with your actual keys.
# ====================================================================

PORT=5000
FLASK_DEBUG=False

# Optional: Google Gemini API Key for dynamic recipe generation of exotic dishes
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Alternative Providers
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Google Cloud Text-to-Speech API key
# GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Set to 1 to list Pachika's own dishes next to online results (default 0: online first, local only as a fallback)
PACHIKA_SHOW_LOCAL_WITH_ONLINE=0
